# Template for the local-dev .env. Copy to `.env` and fill in real
# values; the real file is gitignored. Production deployments load
# equivalent values via `deploy/nrp/k8s/secrets.yaml` instead.

# Mongo — used by docker-compose to provision the root user, and by
# every Rust binary's --mongo-uri default.
BOOM_GW_MONGO_USERNAME=mongoadmin
BOOM_GW_MONGO_PASSWORD=

# In-cluster MinIO credentials (docker-compose `s3` profile). Real
# AWS S3 deployments leave these empty and rely on the SDK's default
# credential chain (IAM role, ~/.aws/credentials, etc.).
BOOM_GW_S3_ACCESS_KEY=
BOOM_GW_S3_SECRET_KEY=

# GCN-Kafka OIDC client. Issued at https://gcn.nasa.gov/quickstart
# — one pair per consumer. Required by `gw_gcn_consumer` when run
# with `--auth oidc` (the default). For local Kafka-on-docker
# testing, pass `--auth plaintext` and leave these blank.
BOOM_GW_GCN_CLIENT_ID=
BOOM_GW_GCN_CLIENT_SECRET=
